{
  "name": "cut-and-combine",
  "version": "1.0.0",
  "private": true,
  "description": "A playful browser UI for trimming and combining videos.",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.clipcandy.cutcombine",
    "productName": "P-Two7",
    "directories": { "output": "release-installer-fixed" },
    "files": ["**/*", "!dist/**", "!release/**", "!release-ptwo7/**", "!release-portable/**", "!release-onefile/**", "!release-installer-fixed/**", "!uploads/**", "!outputs/**"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/ffprobe-static/**"],
    "win": { "target": "portable", "artifactName": "P-Two7.exe" },
    "nsis": { "oneClick": true, "perMachine": false, "allowToChangeInstallationDirectory": true }
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.0.2"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}
